# Production environment — sentinel-x
# All secrets below MUST be set; the API refuses to start with insecure values.
ENVIRONMENT=production
LOG_LEVEL=INFO
BUILD=<ci-build-id>
GIT_REVISION=<git-sha>

DATABASE_URL=postgresql+psycopg://sentinelx:<password>@postgres:5432/sentinelx
REDIS_URL=redis://redis:6379/0
OPENSEARCH_URL=https://opensearch:9200
OBJECT_STORAGE_PATH=/data/evidence

JWT_SECRET=<generate-with: python -c "import secrets;print(secrets.token_urlsafe(64))">
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
ENCRYPTION_KEY=<generate-with: python -c "import secrets;print(secrets.token_urlsafe(32))">
WEBHOOK_SECRET=<generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))">

AI_PROVIDER=openai_compatible
AI_MODEL=gpt-4o-mini
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=<api-key>
AI_STRONG_MODEL=gpt-4o
AI_SMALL_MODEL=gpt-4o-mini
AI_TOKEN_BUDGET_PER_DAY=500000
AI_CACHE_ENABLED=true

CORS_ORIGINS=https://sentinelx.example.com
