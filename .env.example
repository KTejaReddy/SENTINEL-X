# =============================================================================
# SENTINEL X — environment configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# =============================================================================

# --- Core ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
BUILD=local
GIT_REVISION=dev

# --- Database ---
# Local (zero-dependency):  sqlite:///./sentinelx.db
# Docker (PostgreSQL):      postgresql+psycopg://sentinelx:sentinelx@localhost:5432/sentinelx
DATABASE_URL=sqlite:///./sentinelx.db

# --- Infra (optional for local development) ---
REDIS_URL=
OPENSEARCH_URL=
OBJECT_STORAGE_PATH=./storage/evidence

# --- Security: MUST override in production ---
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7
ENCRYPTION_KEY=dev-only-insecure-encryption-key-change-me-000000000000000
WEBHOOK_SECRET=dev-webhook-secret

# --- AI ---
# local = deterministic evidence-driven engine (no API key needed, default)
# openai_compatible = remote model via AI_API_BASE/AI_API_KEY (output is Pydantic-validated)
AI_PROVIDER=local
AI_MODEL=local-heuristic-v1
AI_API_BASE=
AI_API_KEY=
AI_STRONG_MODEL=gpt-4o
AI_SMALL_MODEL=gpt-4o-mini
AI_TOKEN_BUDGET_PER_DAY=500000
AI_CACHE_ENABLED=true

# --- Security tool paths ---
NMAP_PATH=nmap
NUCLEI_PATH=nuclei
ZAP_PATH=zap.sh
SEMGREP_PATH=semgrep
GITLEAKS_PATH=gitleaks
TRIVY_PATH=trivy

# --- SIEM ingest sources (optional file paths) ---
SURICATA_EVE_PATH=
WAZUH_ALERTS_PATH=
ZEEK_LOG_DIR=

# --- Controlled lab range ---
LAB_CIDR=10.10.10.0/24
LAB_NETWORK=lab-network

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
